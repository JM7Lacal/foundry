<Project>

  <!-- Ajustes compartidos por TODOS los proyectos de la solucion.
       El TargetFramework NO va aca: Foundry.App necesita net8.0-windows y el resto net8.0. -->
  <PropertyGroup>
    <!-- Fijo a C# 12 (el que corresponde a .NET 8). "latest" tomaria C# 14 del SDK .NET 10
         co-instalado y rompe cosas como usar 'field' de nombre de variable. -->
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: no exigir doc-comment en cada miembro publico -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
