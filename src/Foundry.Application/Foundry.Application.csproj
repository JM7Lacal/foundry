<Project Sdk="Microsoft.NET.Sdk">

  <!-- Casos de uso y abstracciones (puertos): IContentRepository, IContentImporter, UndoStack.
       Define QUE se necesita, no COMO. Depende solo de Foundry.Core. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Foundry.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foundry.Core\Foundry.Core.csproj" />
  </ItemGroup>

  <!-- Los system prompts viven en el repo como texto versionado y viajan incrustados en el dll. -->
  <ItemGroup>
    <EmbeddedResource Include="Ai\Prompts\*.txt" />
  </ItemGroup>

</Project>
