<Window x:Class="Foundry.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Foundry.Presentation.ViewModels;assembly=Foundry.Presentation"
        xmlns:views="clr-namespace:Foundry.App.Views"
        xmlns:behaviors="clr-namespace:Foundry.App.Behaviors"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}"
        Height="640" Width="1040"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:ContentCategoryViewModel}"
                                  ItemsSource="{Binding Entities}">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type vm:EntityNodeViewModel}">
            <TextBlock Text="{Binding DisplayName}" />
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCommand}" />
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding RedoCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Archivo">
                <MenuItem Header="_Abrir..." InputGestureText="Ctrl+O" Command="{Binding OpenCommand}" />
                <MenuItem Header="_Guardar" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" />
                <Separator />
                <MenuItem Header="_Importar CSV..." Command="{Binding ImportCsvCommand}" />
                <Separator />
                <MenuItem Header="_Salir" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_Editar">
                <MenuItem Header="_Deshacer" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                <MenuItem Header="_Rehacer" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
            </MenuItem>
            <MenuItem Header="_Herramientas">
                <MenuItem Header="_Validar contenido" Command="{Binding ValidateCommand}" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusMessage}" />
        </StatusBar>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="320" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Contenido">
                <DockPanel>
                    <TextBox DockPanel.Dock="Top" Margin="0,0,0,6"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filtrar por nombre o id" />
                    <TreeView ItemsSource="{Binding Categories}"
                              behaviors:TreeViewSelectionBehavior.TrackSelection="True"
                              behaviors:TreeViewSelectionBehavior.SelectedItem="{Binding SelectedTreeItem, Mode=OneWayToSource}"
                              BorderThickness="0" Background="Transparent" />
                </DockPanel>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="6"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch" />

            <GroupBox Grid.Column="2" Header="Inspector">
                <views:InspectorView DataContext="{Binding Inspector}" />
            </GroupBox>

            <GridSplitter Grid.Column="3" Width="6"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch" />

            <TabControl Grid.Column="4">
                <TabItem Header="Preview JSON">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding JsonPreview, Mode=OneWay}"
                                 IsReadOnly="True" BorderThickness="0"
                                 FontFamily="Consolas, Cascadia Mono, monospace"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Disabled"
                                 HorizontalScrollBarVisibility="Disabled" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Asistente">
                    <views:AssistantView DataContext="{Binding Assistant}" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
