<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Pasada de diseño sobre el tema claro por defecto de WPF: paleta coherente, tipografia y
         un GroupBox mas sobrio. Un tema oscuro completo necesitaria ControlTemplates para cada
         control o una libreria; queda fuera de alcance a proposito (ver ADR 0010). -->

    <Color x:Key="AccentColor">#2D6CDF</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="WindowColor">#F4F5F7</Color>
    <Color x:Key="BorderColor">#D9DCE1</Color>
    <Color x:Key="DangerColor">#C0392B</Color>
    <Color x:Key="MutedColor">#6B7280</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource WindowBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                               TextOptions.TextFormattingMode="Display" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    </Style>

    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

</ResourceDictionary>
