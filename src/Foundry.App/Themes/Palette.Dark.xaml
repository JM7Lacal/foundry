<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta OSCURA. Neutra, tipo IDE (VS Code / Rider). Sin negros puros ni saturacion alta:
         es para mirar ocho horas. -->

    <SolidColorBrush x:Key="WindowBrush" Color="#1E1F22" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2D30" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#33363B" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3B3E44" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#4C5057" />
    <SolidColorBrush x:Key="TextBrush" Color="#DFE1E5" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9AA0A8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6BA1FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2D3B55" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#2D3B55" />
    <SolidColorBrush x:Key="HoverBrush" Color="#34373C" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E5645B" />
    <SolidColorBrush x:Key="WarnBrush" Color="#D9A343" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#5DB16B" />

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2D3B55" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#DFE1E5" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#34373C" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#DFE1E5" />

</ResourceDictionary>
