<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta CLARA. Mismas claves que Palette.Dark.xaml; el ThemeManager intercambia este
         diccionario entero en runtime, por eso los estilos referencian los brushes con
         DynamicResource. -->

    <SolidColorBrush x:Key="WindowBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E1E4E8" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CDD2D9" />
    <SolidColorBrush x:Key="TextBrush" Color="#1F2328" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#656D76" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2D6CDF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2559BE" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F0FE" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#E8F0FE" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F0F1F3" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="WarnBrush" Color="#9A6700" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1A7F37" />

    <!-- Seleccion de ListBox/ComboBox del sistema (los que no re-templamos) -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E8F0FE" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1F2328" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#EEF0F2" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1F2328" />

</ResourceDictionary>
