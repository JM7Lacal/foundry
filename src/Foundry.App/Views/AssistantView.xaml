<UserControl x:Class="Foundry.App.Views.AssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Foundry.Presentation.ViewModels;assembly=Foundry.Presentation"
             xmlns:conv="clr-namespace:Foundry.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AssistantViewModel}"
             d:DesignWidth="320">

    <DockPanel Margin="4">
        <TextBlock DockPanel.Dock="Top" Margin="2,0,2,4" Opacity="0.6"
                   Text="{Binding ProviderName, StringFormat='Modelo: {0}'}" />

        <TextBox DockPanel.Dock="Top" Height="70" Margin="2"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,2,2,6">
            <Button Content="Preguntar" Padding="10,3" Command="{Binding AskCommand}" />
            <Button Content="Cancelar" Padding="10,3" Margin="6,0,0,0"
                    Command="{Binding AskCancelCommand}"
                    Visibility="{Binding IsBusy, Converter={x:Static conv:BooleanToVisibilityConverter.VisibleWhenTrue}}" />
            <TextBlock Text="Pensando…" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.6"
                       Visibility="{Binding IsBusy, Converter={x:Static conv:BooleanToVisibilityConverter.VisibleWhenTrue}}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="2">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,0,0,6"
                           Visibility="{Binding ErrorMessage, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />

                <TextBlock Text="{Binding Rationale}" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,6"
                           Visibility="{Binding Rationale, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />

                <TextBlock Text="{Binding Answer}" TextWrapping="Wrap"
                           Visibility="{Binding Answer, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />

                <GroupBox Header="Entidades propuestas" Margin="0,8,0,0" Padding="4"
                          Visibility="{Binding HasProposal, Converter={x:Static conv:BooleanToVisibilityConverter.VisibleWhenTrue}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding ProposalPreview}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="2,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Agregar al contenido" Padding="10,3" Margin="0,6,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding ApplyProposalCommand}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
