<UserControl x:Class="Foundry.App.Views.AssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Foundry.Presentation.ViewModels;assembly=Foundry.Presentation"
             xmlns:conv="clr-namespace:Foundry.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AssistantViewModel}"
             d:DesignWidth="360">

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,6"
                   Text="{Binding ProviderName, StringFormat='Modelo: {0}'}" />

        <TextBlock DockPanel.Dock="Top" Text="ACCIONES RAPIDAS (entidad seleccionada)"
                   Style="{StaticResource SectionCaption}" Margin="0,0,0,6" />
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="Analizar" Margin="0,0,6,6" Command="{Binding AnalyzeEntityCommand}"
                    ToolTip="Revisá los stats en busca de valores sospechosos" />
            <Button Content="Cadena de mejora" Margin="0,0,6,6" Command="{Binding ExplainUpgradesCommand}"
                    ToolTip="Explicá y evaluá la progresión de upgrades" />
            <Button Content="¿Balance?" Margin="0,0,6,6" Command="{Binding CheckBalanceCommand}"
                    ToolTip="Compará contra los enemigos y proponé ajustes" />
        </WrapPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="1">
            <TextBox Height="72" BorderThickness="0" Background="Transparent"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" />
        </Border>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8,0,10">
            <Button Content="Preguntar" Style="{StaticResource AccentButton}" Command="{Binding AskCommand}" />
            <Button Content="Cancelar" Margin="8,0,0,0" Command="{Binding AskCancelCommand}"
                    Visibility="{Binding IsBusy, Converter={x:Static conv:BooleanToVisibilityConverter.VisibleWhenTrue}}" />
            <TextBlock Text="Pensando…" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource Muted}"
                       Visibility="{Binding IsBusy, Converter={x:Static conv:BooleanToVisibilityConverter.VisibleWhenTrue}}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding ErrorMessage, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />

                <TextBlock Text="{Binding Rationale}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding Rationale, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />

                <TextBlock Text="{Binding Answer}" TextWrapping="Wrap"
                           Visibility="{Binding Answer, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />

                <StackPanel Margin="0,12,0,0"
                            Visibility="{Binding HasProposal, Converter={x:Static conv:BooleanToVisibilityConverter.VisibleWhenTrue}}">
                    <TextBlock Text="ENTIDADES PROPUESTAS" Style="{StaticResource SectionCaption}" Margin="0,0,0,6" />
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding ProposalPreview}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Agregar al contenido" Style="{StaticResource AccentButton}"
                            Margin="0,8,0,0" HorizontalAlignment="Left"
                            Command="{Binding ApplyProposalCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
