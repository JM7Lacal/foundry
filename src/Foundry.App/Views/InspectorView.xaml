<UserControl x:Class="Foundry.App.Views.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Foundry.Presentation.ViewModels;assembly=Foundry.Presentation"
             xmlns:insp="clr-namespace:Foundry.Presentation.ViewModels.Inspector;assembly=Foundry.Presentation"
             xmlns:conv="clr-namespace:Foundry.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InspectorViewModel}"
             d:DesignWidth="360">

    <UserControl.Resources>

        <!-- Al fallar la validacion (INotifyDataErrorInfo) mostramos el error en el tooltip. -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                    <Setter Property="ToolTip"
                            Value="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
                            Value="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Un DataTemplate por tipo de campo (elegido por tipo de VM, no por un valor -> templates
             implicitos, no un DataTemplateSelector). -->

        <DataTemplate DataType="{x:Type insp:TextFieldViewModel}">
            <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type insp:WholeNumberFieldViewModel}">
            <DockPanel>
                <TextBox DockPanel.Dock="Right" Width="58" Margin="8,0,0,0" TextAlignment="Right"
                         Text="{Binding Value, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}" />
                <Slider VerticalAlignment="Center"
                        Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                        Value="{Binding Value, Delay=200}"
                        IsSnapToTickEnabled="True" TickFrequency="1"
                        Visibility="{Binding HasRange, Converter={x:Static conv:BooleanToVisibilityConverter.VisibleWhenTrue}}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type insp:NumberFieldViewModel}">
            <DockPanel>
                <TextBox DockPanel.Dock="Right" Width="58" Margin="8,0,0,0" TextAlignment="Right"
                         Text="{Binding Value, UpdateSourceTrigger=LostFocus, StringFormat=0.###, ValidatesOnNotifyDataErrors=True}" />
                <Slider VerticalAlignment="Center"
                        Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                        Value="{Binding Value, Delay=200}"
                        Visibility="{Binding HasRange, Converter={x:Static conv:BooleanToVisibilityConverter.VisibleWhenTrue}}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type insp:ToggleFieldViewModel}">
            <CheckBox IsChecked="{Binding Value}" VerticalAlignment="Center" HorizontalAlignment="Left" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type insp:ChoiceFieldViewModel}">
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type insp:ReferenceFieldViewModel}">
            <ComboBox ItemsSource="{Binding Options}"
                      SelectedItem="{Binding SelectedOption, ValidatesOnNotifyDataErrors=True}"
                      DisplayMemberPath="Label" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Estado vacio -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                    Visibility="{Binding HasEntity, Converter={x:Static conv:BooleanToVisibilityConverter.VisibleWhenFalse}}">
            <TextBlock Text="&#xE7C4;" FontFamily="{StaticResource IconFont}" FontSize="30"
                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="Seleccioná una entidad en el arbol" Style="{StaticResource Muted}"
                       HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasEntity, Converter={x:Static conv:BooleanToVisibilityConverter.VisibleWhenTrue}}">
            <StackPanel>
                <TextBlock Text="{Binding EntityTitle}" Style="{StaticResource Muted}" Margin="0,0,0,10"
                           FontFamily="{StaticResource MonoFont}" FontSize="11" />

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionCaption}" Margin="0,0,0,6" />
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,6" />

                                <ItemsControl ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           ToolTip="{Binding Description}">
                                                    <Run Text="{Binding Label, Mode=OneWay}" />
                                                    <Run Text="{Binding RequiredMark, Mode=OneWay}" Foreground="{StaticResource DangerBrush}" />
                                                </TextBlock>

                                                <StackPanel Grid.Column="1">
                                                    <ContentControl Content="{Binding}" />
                                                    <TextBlock Text="{Binding ErrorText}"
                                                               Foreground="{StaticResource DangerBrush}" FontSize="11"
                                                               TextWrapping="Wrap" Margin="0,3,0,0"
                                                               Visibility="{Binding HasErrors, Converter={x:Static conv:BooleanToVisibilityConverter.VisibleWhenTrue}}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="0,2,0,0"
                            Visibility="{Binding HasUsages, Converter={x:Static conv:BooleanToVisibilityConverter.VisibleWhenTrue}}">
                    <TextBlock Text="USADO POR" Style="{StaticResource SectionCaption}" Margin="0,0,0,6" />
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Usages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="0,2" Style="{StaticResource Muted}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
