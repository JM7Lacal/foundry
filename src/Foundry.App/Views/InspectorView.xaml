<UserControl x:Class="Foundry.App.Views.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Foundry.Presentation.ViewModels;assembly=Foundry.Presentation"
             xmlns:insp="clr-namespace:Foundry.Presentation.ViewModels.Inspector;assembly=Foundry.Presentation"
             xmlns:conv="clr-namespace:Foundry.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InspectorViewModel}"
             d:DesignWidth="320">

    <UserControl.Resources>

        <!-- Al fallar la validacion (INotifyDataErrorInfo) mostramos el error en el tooltip.
             El borde rojo lo pone el ErrorTemplate por defecto de WPF. -->
        <Style TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
                            Value="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
                            Value="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Un DataTemplate por tipo de campo. WPF los aplica implicitamente segun el tipo del
             ViewModel; no hace falta un DataTemplateSelector porque la eleccion depende del tipo,
             no de un valor en runtime. -->

        <DataTemplate DataType="{x:Type insp:TextFieldViewModel}">
            <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type insp:WholeNumberFieldViewModel}">
            <DockPanel>
                <TextBox DockPanel.Dock="Right" Width="56" Margin="6,0,0,0"
                         Text="{Binding Value, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}" />
                <Slider VerticalAlignment="Center"
                        Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                        Value="{Binding Value, Delay=200}"
                        IsSnapToTickEnabled="True" TickFrequency="1"
                        Visibility="{Binding HasRange, Converter={x:Static conv:BooleanToVisibilityConverter.VisibleWhenTrue}}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type insp:NumberFieldViewModel}">
            <DockPanel>
                <TextBox DockPanel.Dock="Right" Width="56" Margin="6,0,0,0"
                         Text="{Binding Value, UpdateSourceTrigger=LostFocus, StringFormat=0.###, ValidatesOnNotifyDataErrors=True}" />
                <Slider VerticalAlignment="Center"
                        Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                        Value="{Binding Value, Delay=200}"
                        Visibility="{Binding HasRange, Converter={x:Static conv:BooleanToVisibilityConverter.VisibleWhenTrue}}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type insp:ToggleFieldViewModel}">
            <CheckBox IsChecked="{Binding Value}" VerticalAlignment="Center" HorizontalAlignment="Left" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type insp:ChoiceFieldViewModel}">
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type insp:ReferenceFieldViewModel}">
            <ComboBox ItemsSource="{Binding Options}"
                      SelectedItem="{Binding SelectedOption, ValidatesOnNotifyDataErrors=True}"
                      DisplayMemberPath="Label" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <TextBlock Margin="8" Opacity="0.6" TextWrapping="Wrap"
                   Text="Seleccioná una entidad en el arbol."
                   Visibility="{Binding HasEntity, Converter={x:Static conv:BooleanToVisibilityConverter.VisibleWhenFalse}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasEntity, Converter={x:Static conv:BooleanToVisibilityConverter.VisibleWhenTrue}}">
            <StackPanel Margin="4">
                <TextBlock Text="{Binding EntityTitle}" Opacity="0.6" Margin="4,2,4,8" />

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <GroupBox Header="{Binding Name}" Margin="0,0,0,8" Padding="4">
                                <ItemsControl ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Description}">
                                                    <Run Text="{Binding Label, Mode=OneWay}" />
                                                    <Run Text="{Binding RequiredMark, Mode=OneWay}" Foreground="#C0392B" />
                                                </TextBlock>

                                                <StackPanel Grid.Column="1">
                                                    <ContentControl Content="{Binding}" />
                                                    <TextBlock Text="{Binding ErrorText}"
                                                               Foreground="#C0392B" FontSize="11"
                                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Visibility="{Binding HasErrors, Converter={x:Static conv:BooleanToVisibilityConverter.VisibleWhenTrue}}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <GroupBox Header="Usado por" Margin="0,4,0,0" Padding="4"
                          Visibility="{Binding HasUsages, Converter={x:Static conv:BooleanToVisibilityConverter.VisibleWhenTrue}}">
                    <ItemsControl ItemsSource="{Binding Usages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="2,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
