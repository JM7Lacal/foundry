<Project Sdk="Microsoft.NET.Sdk">

  <!-- Capa WPF: Views (XAML), converters, behaviors, implementaciones especificas de Windows
       (WpfFilePicker) y el composition root (App.xaml.cs). Los ViewModels viven en
       Foundry.Presentation. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Foundry.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foundry.Presentation\Foundry.Presentation.csproj" />
    <ProjectReference Include="..\Foundry.Infrastructure\Foundry.Infrastructure.csproj" />
    <ProjectReference Include="..\Foundry.Application\Foundry.Application.csproj" />
    <ProjectReference Include="..\Foundry.Core\Foundry.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contenido de ejemplo que se carga al arrancar; se copia junto al ejecutable. -->
    <None Update="Samples\tower-defense.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
