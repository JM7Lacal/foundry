<Project Sdk="Microsoft.NET.Sdk">

  <!-- Capa de presentacion: WPF, XAML, ViewModels y el composition root (App.xaml.cs).
       Es el unico proyecto que referencia a todos los demas. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Foundry.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foundry.Infrastructure\Foundry.Infrastructure.csproj" />
    <ProjectReference Include="..\Foundry.Application\Foundry.Application.csproj" />
    <ProjectReference Include="..\Foundry.Core\Foundry.Core.csproj" />
  </ItemGroup>

</Project>
